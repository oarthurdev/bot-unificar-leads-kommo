# ===== Conta Kommo =====
# Subdomínio da conta: https://SEUSUBDOMINIO.kommo.com
KOMMO_SUBDOMAIN=seusubdominio
KOMMO_DOMAIN=kommo.com

# (Opcional) URL customizada da lista de leads (ex.: já filtrada por pipeline/etapa).
# Se vazio, usa https://SUBDOMINIO.DOMINIO/leads/list/
CUSTOM_LIST_URL=

# ===== Comportamento =====
# true = navegador invisível (mais rápido). Use false na primeira vez para calibrar.
HEADLESS=true

# true = simula tudo mas NÃO confirma a unificação (recomendado no primeiro teste)
DRY_RUN=true

# Quantos GRUPOS de duplicados unificar por execução (0 = todos de uma vez)
BATCH_SIZE=50

# Máximo de leads selecionados numa única unificação (grupos maiores são divididos
# em rodadas, sempre mantendo o lead mais recente em todas)
MAX_LEADS_POR_UNIFICACAO=6

# Pausa entre grupos, em ms (evita rate-limit / sobrecarga da UI)
PAUSA_ENTRE_GRUPOS_MS=800

# Timeout padrão de espera de elementos, em ms
TIMEOUT_MS=20000

# Desacelerar ações para depuração (ms entre ações; 0 = velocidade máxima)
SLOW_MO=0
